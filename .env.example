# Required in production (Cloud Run sets K_SERVICE; the app refuses to boot
# without these). Generate strong random values, never use the defaults.
SECRET_KEY=change-me
COOKIE_SECRET=change-me
# Required in production. Without it the app refuses to start instead of
# silently falling back to an ephemeral local SQLite file.
DATABASE_URL=postgresql://user:password@host/dbname

# Optional Telegram integration. Leave blank to disable the webhook entirely.
# Secret Manager rejects empty payloads, so do not create Secret Manager
# secrets for these unless you supply a value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

PORT=8080
